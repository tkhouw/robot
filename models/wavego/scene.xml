<mujoco model="wavego_scene">
  <include file="wavego.xml"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
    <!-- Lightweight rendering options: disable shadow map calculations -->
    <quality shadowsize="0"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="128" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="100" height="100"/>
    <!-- Zero reflectance to avoid secondary render passes -->
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.0"/>
    <!-- Living space realistic materials -->
    <material name="wall_paint" rgba="0.88 0.88 0.86 1.0" specular="0.1" shininess="0.1"/>
    <material name="sofa_fabric" rgba="0.28 0.35 0.44 1.0" specular="0.05" shininess="0.05"/>
    <material name="sofa_cushion" rgba="0.32 0.40 0.50 1.0" specular="0.05" shininess="0.05"/>
    <material name="wood_oak" rgba="0.68 0.48 0.30 1.0" specular="0.2" shininess="0.2"/>
    <material name="table_metal" rgba="0.15 0.15 0.16 1.0" specular="0.5" shininess="0.5"/>
    <material name="counter_cabinet" rgba="0.92 0.92 0.90 1.0" specular="0.15" shininess="0.2"/>
    <material name="counter_top" rgba="0.20 0.22 0.25 1.0" specular="0.4" shininess="0.6"/>
    <material name="cardboard" rgba="0.76 0.58 0.38 1.0" specular="0.05" shininess="0.05"/>
    <material name="tape_stripe" rgba="0.88 0.72 0.48 1.0" specular="0.1" shininess="0.1"/>
    <material name="tv_frame" rgba="0.1 0.1 0.12 1.0" specular="0.6" shininess="0.6"/>
    <material name="tv_screen" rgba="0.05 0.08 0.12 1.0" specular="0.8" shininess="0.9"/>
    <material name="plant_pot" rgba="0.85 0.80 0.75 1.0" specular="0.2" shininess="0.3"/>
    <material name="plant_soil" rgba="0.22 0.16 0.12 1.0" specular="0.0" shininess="0.0"/>
    <material name="plant_leaves" rgba="0.18 0.55 0.22 1.0" specular="0.15" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="1.5 0 3.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.02" type="plane" material="groundplane"/>

    <!-- 3rd-person spectator camera: directly overhead following the robot tightly (zoomed in) -->
    

    <!-- ==================== APARTMENT PERIMETER WALLS (5.6m x 4.4m, 2.5x floor area) ==================== -->
    <!-- Enclosure: x in [-1.20, 4.40] (span 5.60m, center 1.60m), y in [-2.20, 2.20] (span 4.40m, center 0.00m) -->
    <!-- North Wall: y = 2.20 -->
    <geom name="wall_north" type="box" size="2.80 0.04 0.60" pos="1.60 2.20 0.60" material="wall_paint"/>
    <!-- South Wall: y = -2.20 -->
    <geom name="wall_south" type="box" size="2.80 0.04 0.60" pos="1.60 -2.20 0.60" material="wall_paint"/>
    <!-- West Wall (Behind Dock): x = -1.20 -->
    <geom name="wall_west" type="box" size="0.04 2.20 0.60" pos="-1.20 0.0 0.60" material="wall_paint"/>
    <!-- East Wall: x = 4.40, with 0.85m doorway at Front Door (3.80, 0.0) -->
    <geom name="wall_east_n" type="box" size="0.04 0.88 0.60" pos="4.40 1.32 0.60" material="wall_paint"/>
    <geom name="wall_east_s" type="box" size="0.04 0.88 0.60" pos="4.40 -1.32 0.60" material="wall_paint"/>
    <geom name="door_lintel" type="box" size="0.04 0.44 0.10" pos="4.40 0.0 1.10" material="wall_paint"/>

    <!-- ==================== INTERIOR PARTITION WALL (Kitchen vs Living Room) ==================== -->
    <!-- Runs along x = 2.10m from y = -2.20m to y = -0.50m (length 1.70m), leaving 1.0m doorway into kitchen -->
    <geom name="kitchen_wall" type="box" size="0.04 0.85 0.60" pos="2.10 -1.35 0.60" material="wall_paint"/>

    <!-- ==================== KITCHEN ISLAND & COUNTER ==================== -->
    <!-- In dedicated kitchen area: center at (3.20, -1.30) -->
    <body name="kitchen_counter" pos="3.20 -1.30 0">
      <geom name="kc_base" type="box" size="0.88 0.32 0.43" pos="0 0 0.43" material="counter_cabinet"/>
      <geom name="kc_top" type="box" size="0.92 0.36 0.02" pos="0 0 0.88" material="counter_top"/>
    </body>

    <!-- ==================== LIVING ROOM 3-SEATER SOFA ==================== -->
    <!-- Positioned along North wall: center at (1.10, 1.70) -->
    <body name="living_sofa" pos="1.10 1.70 0">
      <geom name="sofa_frame" type="box" size="1.00 0.40 0.16" pos="0 0 0.16" material="sofa_fabric"/>
      <geom name="sofa_seat1" type="box" size="0.30 0.32 0.06" pos="-0.62 -0.04 0.38" material="sofa_cushion"/>
      <geom name="sofa_seat2" type="box" size="0.30 0.32 0.06" pos="0.00 -0.04 0.38" material="sofa_cushion"/>
      <geom name="sofa_seat3" type="box" size="0.30 0.32 0.06" pos="0.62 -0.04 0.38" material="sofa_cushion"/>
      <geom name="sofa_back" type="box" size="0.96 0.10 0.20" pos="0 0.32 0.58" material="sofa_cushion"/>
      <geom name="sofa_arm_l" type="box" size="0.08 0.42 0.15" pos="-0.94 0 0.47" material="sofa_fabric"/>
      <geom name="sofa_arm_r" type="box" size="0.08 0.42 0.15" pos="0.94 0 0.47" material="sofa_fabric"/>
    </body>

    <!-- ==================== COFFEE TABLE (Walkable Clearance Underneath) ==================== -->
    <!-- Positioned in front of sofa: center at (1.10, 0.85) -->
    <body name="coffee_table" pos="1.10 0.85 0">
      <geom name="ct_top" type="box" size="0.52 0.26 0.015" pos="0 0 0.405" material="wood_oak"/>
      <geom name="ct_leg_fl" type="cylinder" size="0.015 0.195" pos="-0.48 -0.22 0.195" material="table_metal"/>
      <geom name="ct_leg_fr" type="cylinder" size="0.015 0.195" pos="0.48 -0.22 0.195" material="table_metal"/>
      <geom name="ct_leg_bl" type="cylinder" size="0.015 0.195" pos="-0.48 0.22 0.195" material="table_metal"/>
      <geom name="ct_leg_br" type="cylinder" size="0.015 0.195" pos="0.48 0.22 0.195" material="table_metal"/>
    </body>

    <!-- ==================== 55-INCH WIDESCREEN TV & MEDIA CONSOLE ==================== -->
    <!-- Positioned facing the sofa: center at (1.10, -0.20) -->
    <body name="media_center" pos="1.10 -0.20 0">
      <!-- Low Media Console Table (H = 0.36m, Length = 1.40m, Depth = 0.35m) -->
      <geom name="tv_stand" type="box" size="0.70 0.18 0.18" pos="0 0 0.18" material="wood_oak"/>
      <!-- TV Pedestal base -->
      <geom name="tv_base" type="box" size="0.22 0.12 0.01" pos="0 0 0.37" material="tv_frame"/>
      <geom name="tv_stem" type="box" size="0.04 0.03 0.08" pos="0 0 0.45" material="tv_frame"/>
      <!-- TV Bezel Frame (55 inch: 1.22m x 0.70m) -->
      <geom name="tv_bezel" type="box" size="0.61 0.02 0.35" pos="0 0 0.88" material="tv_frame"/>
      <!-- Glossy TV Display Screen -->
      <geom name="tv_display" type="box" size="0.59 0.005 0.33" pos="0 -0.016 0.88" material="tv_screen"/>
    </body>

    <!-- ==================== POTTED LIVING ROOM HOUSEPLANT ==================== -->
    <!-- Positioned in corner by living room: ( -0.80, 1.80 ) -->
    <body name="potted_plant" pos="-0.80 1.80 0">
      <!-- Ceramic Planter Pot (Radius 0.20m, Height 0.42m) -->
      <geom name="plant_pot" type="cylinder" size="0.20 0.21" pos="0 0 0.21" material="plant_pot"/>
      <!-- Top Soil -->
      <geom name="plant_soil" type="cylinder" size="0.185 0.01" pos="0 0 0.415" material="plant_soil"/>
      <!-- Lush Foliage Canopies (layered spheres for realistic green houseplant look) -->
      <geom name="leaf_center" type="sphere" size="0.26" pos="0 0 0.65" material="plant_leaves"/>
      <geom name="leaf_sw" type="sphere" size="0.18" pos="-0.12 -0.10 0.58" material="plant_leaves"/>
      <geom name="leaf_ne" type="sphere" size="0.18" pos="0.12 0.10 0.60" material="plant_leaves"/>
      <geom name="leaf_se" type="sphere" size="0.16" pos="0.10 -0.12 0.55" material="plant_leaves"/>
      <geom name="leaf_top" type="sphere" size="0.15" pos="0 0 0.82" material="plant_leaves"/>
    </body>

    <!-- ==================== CORRIDOR DELIVERY PARCEL ==================== -->
    <!-- Placed in entranceway near (2.50, 0.15) -->
    <body name="delivery_box" pos="2.50 0.15 0">
      <geom name="box_body" type="box" size="0.19 0.16 0.14" pos="0 0 0.14" material="cardboard"/>
      <geom name="box_tape" type="box" size="0.035 0.161 0.002" pos="0 0 0.281" material="tape_stripe"/>
    </body>
  </worldbody>
</mujoco>
